# .env.example — CatchyLabs environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ────────────────────────────────────────────────────────────────────────────
# Security
# ────────────────────────────────────────────────────────────────────────────

# Secret key required on every API request (except GET /health) via the
# X-API-Key header.  Use a long random string (e.g. `openssl rand -hex 32`).
CATCHYLAB_API_KEY=

# Comma-separated list of allowed CORS origins, e.g.:
#   ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
# Leave empty to disable cross-origin browser requests. Add exact origins when needed.
ALLOWED_ORIGINS=

# ────────────────────────────────────────────────────────────────────────────
# Rate limiting
# ────────────────────────────────────────────────────────────────────────────

# Maximum number of POST /research calls allowed per UTC day.
# The count is stored in the database, so restarting the server does not
# reset it.  Default: 5
MAX_RUNS_PER_DAY=5
MAX_STAGE_RUNS_PER_DAY=20
MAX_SERPAPI_PER_DAY=15

# ────────────────────────────────────────────────────────────────────────────
# Database
# ────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string for the live (production) database.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ────────────────────────────────────────────────────────────────────────────
# External APIs
# ────────────────────────────────────────────────────────────────────────────

# Google Gemini API key.
GEMINI_API_KEY=

# SerpAPI key for web search.
SERPAPI_API_KEY=

# ────────────────────────────────────────────────────────────────────────────
# Upstash Redis (RQ job queue)
# ────────────────────────────────────────────────────────────────────────────

UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=rediss://default:TOKEN@your-instance.upstash.io:6379

# ────────────────────────────────────────────────────────────────────────────
# Server
# ────────────────────────────────────────────────────────────────────────────

# Port uvicorn listens on (used by start.sh).  Default: 8000
PORT=8000

# ────────────────────────────────────────────────────────────────────────────
# Supabase account auth and user-scoped AI provider connections
# ────────────────────────────────────────────────────────────────────────────

# Supabase project URL and public anon key. These validate CatchyLab user sessions.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# URL-safe base64 encoding of exactly 32 random bytes. Generate with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Store separately in the deployment secret manager; losing it makes stored provider
# credentials unreadable. Plan key rotation before changing it.
PROVIDER_ENCRYPTION_KEY=

# Gemini OAuth for the Gemini Developer API only. Register GOOGLE_OAUTH_REDIRECT_URI
# exactly in a Google Cloud OAuth client and enable the Generative Language API.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
FRONTEND_URL=

# ────────────────────────────────────────────────────────────────────────────
# Self-hosted, local-only voice pipeline
# ────────────────────────────────────────────────────────────────────────────

# Dictated messages use only the local Ollama model when enabled. Defaults to
# true. Setting this to false allows dictated TEXT to use the selected provider;
# audio remains local-transcribed and is never sent to any provider API.
VOICE_LOCAL_ONLY=1
LOCAL_VOICE_LLM_MODEL=qwen3:4b

# Optional local executable paths. No speech models are downloaded automatically.
LOCAL_STT_BINARY=whisper-cli
LOCAL_STT_FFMPEG=ffmpeg
# Set to the absolute path of a manually downloaded multilingual whisper.cpp model.
LOCAL_STT_MODEL_PATH=
